# Copy to .env (git-ignored) and fill in real values for local docker-compose use.
POSTGRES_DB=lendinglibrary
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

ASPNETCORE_ENVIRONMENT=Development

# Bootstrap admin — leave blank to skip admin seeding.
# Note: docker-compose interpolates $ in .env values, so a literal $ must be
# written as $$ (e.g. a password of "Ab1$Cd" goes in here as "Ab1$$Cd").
ADMIN_EMAIL=
ADMIN_PASSWORD=
