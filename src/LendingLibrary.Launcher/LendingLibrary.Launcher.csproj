<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows-only convenience tool: starts Docker Desktop + the app's containers and opens
    the default browser at the home page. Not part of the deployed app.
    Build a double-clickable exe with: dotnet publish -c Release
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>LendingLibrary-Launcher</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
