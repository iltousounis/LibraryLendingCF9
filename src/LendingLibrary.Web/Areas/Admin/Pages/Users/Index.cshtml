@page
@model LendingLibrary.Web.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="flex items-center justify-between">
    <h1 class="page-title">Users</h1>
    <a asp-page="./Create" class="btn-primary">
        New user
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 alert-success">@Model.StatusMessage</p>
}

<form method="get" class="mt-4 flex items-end gap-3 rounded-lg border border-stone-200 bg-white p-4">
    <div>
        <label asp-for="Q" class="field-label">Search</label>
        <input asp-for="Q" placeholder="Name or email..." class="field-input w-64" />
    </div>
    <button type="submit" class="btn-secondary">
        Search
    </button>
</form>

<div class="mt-6 table-card">
    <table class="table-base">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Results.Items)
            {
                var locked = Model.LockedByUserId[user.Id];
                <tr>
                    <td class="font-medium text-stone-900">@user.DisplayName</td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ", Model.RolesByUserId[user.Id])</td>
                    <td>
                        @if (locked)
                        {
                            <span class="badge-danger">Disabled</span>
                        }
                        else
                        {
                            <span class="badge-success">Active</span>
                        }
                    </td>
                    <td class="text-right">
                        <form method="post" asp-page-handler="ToggleLock" asp-route-userId="@user.Id" asp-route-locked="@(!locked)" asp-route-page="@Model.PageNumber">
                            <button type="submit" class="link-muted">@(locked ? "Enable" : "Disable")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-stone-500">No users match your search.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
