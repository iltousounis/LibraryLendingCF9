@page
@model LendingLibrary.Web.Areas.Admin.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Users</h1>
    <a asp-page="./Create" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
        New user
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 rounded-md bg-green-50 px-3 py-2 text-sm text-green-700">@Model.StatusMessage</p>
}

<form method="get" class="mt-4 flex items-end gap-3">
    <div>
        <label asp-for="Q" class="block text-sm font-medium">Search</label>
        <input asp-for="Q" placeholder="Name or email..." class="mt-1 block w-64 rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>
    <button type="submit" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-100">
        Search
    </button>
</form>

<div class="mt-6 overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Name</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Email</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Role</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Status</th>
                <th class="px-4 py-2"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var user in Model.Results.Items)
            {
                var locked = Model.LockedByUserId[user.Id];
                <tr>
                    <td class="px-4 py-2 font-medium">@user.DisplayName</td>
                    <td class="px-4 py-2">@user.Email</td>
                    <td class="px-4 py-2">@string.Join(", ", Model.RolesByUserId[user.Id])</td>
                    <td class="px-4 py-2">
                        @if (locked)
                        {
                            <span class="rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">Disabled</span>
                        }
                        else
                        {
                            <span class="rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">Active</span>
                        }
                    </td>
                    <td class="px-4 py-2 text-right">
                        <form method="post" asp-page-handler="ToggleLock" asp-route-userId="@user.Id" asp-route-locked="@(!locked)" asp-route-page="@Model.PageNumber">
                            <button type="submit" class="text-gray-700 hover:underline">@(locked ? "Enable" : "Disable")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-gray-500">No users match your search.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
