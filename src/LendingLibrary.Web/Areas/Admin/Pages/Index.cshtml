@page
@model LendingLibrary.Web.Areas.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1 class="text-2xl font-bold">Admin dashboard</h1>

<dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
    <a asp-page="/Catalogue/Index" class="rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
        <dt class="text-sm text-gray-500">Catalogue items</dt>
        <dd class="text-2xl font-semibold">@Model.TotalItems</dd>
    </a>
    <a asp-page="/Loans/Index" class="rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
        <dt class="text-sm text-gray-500">On loan</dt>
        <dd class="text-2xl font-semibold">@Model.ItemsOnLoan</dd>
    </a>
    <a asp-page="/Loans/Overdue" class="rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
        <dt class="text-sm text-gray-500">Overdue</dt>
        <dd class="text-2xl font-semibold text-red-600">@Model.OverdueLoans</dd>
    </a>
    <a asp-page="/Reservations/Index" class="rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
        <dt class="text-sm text-gray-500">Active reservations</dt>
        <dd class="text-2xl font-semibold">@Model.ActiveReservations</dd>
    </a>
    <a asp-page="/Users/Index" class="rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
        <dt class="text-sm text-gray-500">Registered users</dt>
        <dd class="text-2xl font-semibold">@Model.RegisteredUsers</dd>
    </a>
</dl>
