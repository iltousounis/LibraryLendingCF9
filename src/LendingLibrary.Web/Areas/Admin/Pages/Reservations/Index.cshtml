@page
@model LendingLibrary.Web.Areas.Admin.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "Pending reservations";
}

<h1 class="page-title">Pending reservations</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 alert-success">@Model.StatusMessage</p>
}

<div class="mt-6 table-card">
    <table class="table-base">
        <thead>
            <tr>
                <th>Item</th>
                <th>Reserved by</th>
                <th>Reserved</th>
                <th>Expires</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservation in Model.Results.Items)
            {
                <tr>
                    <td class="font-medium text-stone-900">@reservation.CatalogueItem.Title</td>
                    <td>@reservation.User.DisplayName (@reservation.User.Email)</td>
                    <td>@reservation.ReservedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td>@reservation.ExpiresAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td class="text-right whitespace-nowrap">
                        <form method="post" asp-page-handler="Fulfil" asp-route-reservationId="@reservation.Id" asp-route-page="@Model.PageNumber" class="inline">
                            <button type="submit" class="link-muted">Fulfil</button>
                        </form>
                        <form method="post" asp-page-handler="Cancel" asp-route-reservationId="@reservation.Id" asp-route-page="@Model.PageNumber" class="ml-3 inline">
                            <button type="submit" class="link-danger">Cancel</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-stone-500">No pending reservations.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
