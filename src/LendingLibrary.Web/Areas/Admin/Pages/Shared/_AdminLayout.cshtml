<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin - Library Lending</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="h-full bg-stone-50 text-stone-900 antialiased">
    <a href="#main-content" class="skip-link rounded-md bg-amber-900 px-3 py-2 text-sm font-medium text-white">Skip to content</a>

    <header class="border-b border-stone-950 bg-stone-900 text-white">
        <nav class="relative mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Admin">
            <a class="flex items-center gap-2 font-serif text-lg font-semibold" asp-area="Admin" asp-page="/Index">
                Library Lending <span class="rounded bg-amber-800 px-1.5 py-0.5 text-xs font-sans font-semibold uppercase tracking-wide">Admin</span>
            </a>

            <ul class="hidden items-center gap-5 text-sm sm:flex">
                <li><a class="text-stone-300 transition-colors hover:text-amber-400" asp-area="Admin" asp-page="/Catalogue/Index">Catalogue</a></li>
                <li><a class="text-stone-300 transition-colors hover:text-amber-400" asp-area="Admin" asp-page="/Loans/Index">Loans</a></li>
                <li><a class="text-stone-300 transition-colors hover:text-amber-400" asp-area="Admin" asp-page="/Reservations/Index">Reservations</a></li>
                <li><a class="text-stone-300 transition-colors hover:text-amber-400" asp-area="Admin" asp-page="/Users/Index">Users</a></li>
                <li><a class="text-stone-300 transition-colors hover:text-amber-400" asp-area="" asp-page="/Index">Back to site</a></li>
                <li>
                    <form method="post" asp-area="" asp-page="/Account/Logout">
                        <button type="submit" class="text-stone-300 transition-colors hover:text-amber-400">Logout</button>
                    </form>
                </li>
            </ul>

            <details class="sm:hidden">
                <summary class="list-none rounded-md border border-stone-600 px-3 py-1.5 text-sm">Menu</summary>
                <ul class="absolute inset-x-0 top-full z-10 space-y-3 border-t border-stone-800 bg-stone-900 px-4 py-4 text-sm shadow-sm">
                    <li><a class="text-stone-300 hover:text-amber-400" asp-area="Admin" asp-page="/Catalogue/Index">Catalogue</a></li>
                    <li><a class="text-stone-300 hover:text-amber-400" asp-area="Admin" asp-page="/Loans/Index">Loans</a></li>
                    <li><a class="text-stone-300 hover:text-amber-400" asp-area="Admin" asp-page="/Reservations/Index">Reservations</a></li>
                    <li><a class="text-stone-300 hover:text-amber-400" asp-area="Admin" asp-page="/Users/Index">Users</a></li>
                    <li><a class="text-stone-300 hover:text-amber-400" asp-area="" asp-page="/Index">Back to site</a></li>
                    <li>
                        <form method="post" asp-area="" asp-page="/Account/Logout">
                            <button type="submit" class="text-stone-300 hover:text-amber-400">Logout</button>
                        </form>
                    </li>
                </ul>
            </details>
        </nav>
    </header>

    <main id="main-content" class="mx-auto max-w-5xl px-4 py-8">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
