@page
@model LendingLibrary.Web.Areas.Admin.Pages.Loans.OverdueModel
@{
    ViewData["Title"] = "Overdue report";
}

<div class="flex items-center justify-between">
    <h1 class="page-title">Overdue report</h1>
    <a asp-page="./Index" class="link text-sm">All active loans &rarr;</a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 alert-success">@Model.StatusMessage</p>
}

<div class="mt-6 table-card">
    <table class="table-base">
        <thead>
            <tr>
                <th>Item</th>
                <th>Borrower</th>
                <th>Borrowed</th>
                <th>Due</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var loan in Model.Results.Items)
            {
                <tr>
                    <td class="font-medium text-stone-900">@loan.CatalogueItem.Title</td>
                    <td>@loan.User.DisplayName (@loan.User.Email)</td>
                    <td>@loan.BorrowedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td>
                        @loan.DueAtUtc.ToLocalTime().ToString("d MMM yyyy")
                        <span class="badge-danger ml-1">Overdue</span>
                    </td>
                    <td class="text-right">
                        <form method="post" asp-page-handler="Return" asp-route-loanId="@loan.Id" asp-route-page="@Model.PageNumber">
                            <button type="submit" class="link-muted">Mark returned</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-stone-500">No overdue loans.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
