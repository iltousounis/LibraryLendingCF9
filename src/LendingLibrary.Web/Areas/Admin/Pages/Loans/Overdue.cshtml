@page
@model LendingLibrary.Web.Areas.Admin.Pages.Loans.OverdueModel
@{
    ViewData["Title"] = "Overdue report";
}

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Overdue report</h1>
    <a asp-page="./Index" class="text-sm text-gray-600 hover:text-gray-900">All active loans &rarr;</a>
</div>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 rounded-md bg-green-50 px-3 py-2 text-sm text-green-700">@Model.StatusMessage</p>
}

<div class="mt-6 overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Item</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Borrower</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Borrowed</th>
                <th class="px-4 py-2 text-left font-medium text-gray-500">Due</th>
                <th class="px-4 py-2"></th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
            @foreach (var loan in Model.Results.Items)
            {
                <tr>
                    <td class="px-4 py-2 font-medium">@loan.CatalogueItem.Title</td>
                    <td class="px-4 py-2">@loan.User.DisplayName (@loan.User.Email)</td>
                    <td class="px-4 py-2">@loan.BorrowedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                    <td class="px-4 py-2">
                        @loan.DueAtUtc.ToLocalTime().ToString("d MMM yyyy")
                        <span class="ml-1 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">Overdue</span>
                    </td>
                    <td class="px-4 py-2 text-right">
                        <form method="post" asp-page-handler="Return" asp-route-loanId="@loan.Id" asp-route-page="@Model.PageNumber">
                            <button type="submit" class="text-gray-700 hover:underline">Mark returned</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-gray-500">No overdue loans.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
