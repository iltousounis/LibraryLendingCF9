@page "{id:guid}"
@model LendingLibrary.Web.Areas.Admin.Pages.Catalogue.EditModel
@using LendingLibrary.Web.Domain.Enums
@{
    ViewData["Title"] = "Edit catalogue item";
}

<h1 class="text-2xl font-bold">Edit catalogue item</h1>

<form method="post" class="mt-6 max-w-2xl space-y-4">
    <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.RowVersion" />

    <div>
        <label asp-for="Input.Title" class="block text-sm font-medium">Title</label>
        <input asp-for="Input.Title" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
        <span asp-validation-for="Input.Title" class="text-sm text-red-600"></span>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <div>
            <label asp-for="Input.ItemType" class="block text-sm font-medium">Item type</label>
            <select asp-for="Input.ItemType" asp-items="Html.GetEnumSelectList<ItemType>()" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm"></select>
            <span asp-validation-for="Input.ItemType" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Input.TotalUnits" class="block text-sm font-medium">Total units</label>
            <input asp-for="Input.TotalUnits" type="number" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
            <span asp-validation-for="Input.TotalUnits" class="text-sm text-red-600"></span>
        </div>
    </div>

    <div>
        <label asp-for="Input.Authors" class="block text-sm font-medium">Author(s)</label>
        <input asp-for="Input.Authors" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>

    <div class="grid grid-cols-3 gap-4">
        <div>
            <label asp-for="Input.Publisher" class="block text-sm font-medium">Publisher</label>
            <input asp-for="Input.Publisher" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
        </div>
        <div>
            <label asp-for="Input.Isbn" class="block text-sm font-medium">ISBN</label>
            <input asp-for="Input.Isbn" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
            <span asp-validation-for="Input.Isbn" class="text-sm text-red-600"></span>
        </div>
        <div>
            <label asp-for="Input.PublicationYear" class="block text-sm font-medium">Year</label>
            <input asp-for="Input.PublicationYear" type="number" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
            <span asp-validation-for="Input.PublicationYear" class="text-sm text-red-600"></span>
        </div>
    </div>

    <div>
        <label asp-for="Input.CoverImageUrl" class="block text-sm font-medium">Cover image URL</label>
        <input asp-for="Input.CoverImageUrl" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
        <span asp-validation-for="Input.CoverImageUrl" class="text-sm text-red-600"></span>
    </div>

    <div>
        <label asp-for="Input.Description" class="block text-sm font-medium">Description</label>
        <textarea asp-for="Input.Description" rows="4" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm"></textarea>
    </div>

    <div class="flex gap-3">
        <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
            Save
        </button>
        <a asp-page="./Index" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-100">
            Cancel
        </a>
    </div>
</form>
