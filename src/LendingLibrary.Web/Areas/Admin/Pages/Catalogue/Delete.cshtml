@page "{id:guid}"
@model LendingLibrary.Web.Areas.Admin.Pages.Catalogue.DeleteModel
@{
    ViewData["Title"] = "Delete catalogue item";
}

<h1 class="page-title">Delete catalogue item</h1>

<div class="mt-4 max-w-xl rounded-lg border border-stone-200 bg-white p-6">
    <p class="text-stone-700">
        Are you sure you want to delete <strong>@Model.Item.Title</strong>? This removes it from the
        catalogue and public listings; existing loan history is preserved.
    </p>

    <form method="post" class="mt-6 flex gap-3">
        <button type="submit" class="btn-danger">
            Delete
        </button>
        <a asp-page="./Index" class="btn-secondary">
            Cancel
        </a>
    </form>
</div>
