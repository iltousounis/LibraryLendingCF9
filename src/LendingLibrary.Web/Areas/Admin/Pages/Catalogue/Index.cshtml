@page
@model LendingLibrary.Web.Areas.Admin.Pages.Catalogue.IndexModel
@using LendingLibrary.Web.Domain.Enums
@{
    ViewData["Title"] = "Catalogue";
}

<div class="flex items-center justify-between">
    <h1 class="page-title">Catalogue</h1>
    <a asp-page="./Create" class="btn-primary">
        New item
    </a>
</div>

<form method="get" class="mt-4 flex flex-wrap items-end gap-3 rounded-lg border border-stone-200 bg-white p-4">
    <div>
        <label asp-for="Q" class="field-label">Search</label>
        <input asp-for="Q" placeholder="Title, author, ISBN, publisher..." class="field-input w-64" />
    </div>
    <div>
        <label asp-for="Type" class="field-label">Type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ItemType>()" class="field-input">
            <option value="">Any</option>
        </select>
    </div>
    <button type="submit" class="btn-secondary">
        Search
    </button>
</form>

<div class="mt-6 table-card">
    <table class="table-base">
        <thead>
            <tr>
                <th>Title</th>
                <th>Type</th>
                <th>ISBN</th>
                <th class="text-right">Available / Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Results.Items)
            {
                <tr>
                    <td class="font-medium text-stone-900">@item.Title</td>
                    <td>@item.ItemType</td>
                    <td>@item.Isbn</td>
                    <td class="text-right">@item.AvailableUnits / @item.TotalUnits</td>
                    <td class="text-right">
                        <a class="link-muted" asp-page="./Edit" asp-route-id="@item.Id">Edit</a>
                        <a class="link-danger ml-3" asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
            @if (Model.Results.Items.Count == 0)
            {
                <tr>
                    <td colspan="5" class="px-4 py-6 text-center text-stone-500">No items match your search.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" model="Model.Pager" />
