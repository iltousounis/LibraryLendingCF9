@model LendingLibrary.Web.Infrastructure.PagerViewModel
@{
    var start = Math.Max(1, Model.Page - 2);
    var end = Math.Min(Model.TotalPages, Model.Page + 2);
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-6 flex items-center justify-center gap-1 text-sm" aria-label="Pagination">
        <a class="rounded-md border border-gray-300 px-3 py-1.5 @(Model.Page <= 1 ? "pointer-events-none opacity-40" : "hover:bg-gray-100")"
           href="@Model.PageUrl(Math.Max(Model.Page - 1, 1))">Prev</a>

        @for (var p = start; p <= end; p++)
        {
            <a class="rounded-md border px-3 py-1.5 @(p == Model.Page ? "border-gray-900 bg-gray-900 text-white" : "border-gray-300 hover:bg-gray-100")"
               href="@Model.PageUrl(p)">@p</a>
        }

        <a class="rounded-md border border-gray-300 px-3 py-1.5 @(Model.Page >= Model.TotalPages ? "pointer-events-none opacity-40" : "hover:bg-gray-100")"
           href="@Model.PageUrl(Math.Min(Model.Page + 1, Model.TotalPages))">Next</a>
    </nav>
}
