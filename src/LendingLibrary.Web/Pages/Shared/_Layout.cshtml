<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Library Lending</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="h-full bg-stone-50 text-stone-900 antialiased">
    <a href="#main-content" class="skip-link rounded-md bg-amber-900 px-3 py-2 text-sm font-medium text-white">Skip to content</a>

    <header class="border-b border-stone-200 bg-white">
        <nav class="relative mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main">
            <a class="flex items-center gap-2 font-serif text-lg font-semibold text-stone-900" asp-area="" asp-page="/Index">
                <span aria-hidden="true" class="text-amber-800">&#128214;</span>
                Library Lending
            </a>

            <ul class="hidden items-center gap-5 sm:flex">
                <li><a class="nav-link" asp-area="" asp-page="/Index">Home</a></li>
                <li><a class="nav-link" asp-area="" asp-page="/Catalogue/Index">Catalogue</a></li>
                <li><a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a></li>
                <partial name="_LoginPartial" />
            </ul>

            <details class="sm:hidden">
                <summary class="list-none rounded-md border border-stone-300 px-3 py-1.5 text-sm">Menu</summary>
                <ul class="absolute inset-x-0 top-full z-10 space-y-3 border-t border-stone-200 bg-white px-4 py-4 shadow-sm">
                    <li><a class="nav-link" asp-area="" asp-page="/Index">Home</a></li>
                    <li><a class="nav-link" asp-area="" asp-page="/Catalogue/Index">Catalogue</a></li>
                    <li><a class="nav-link" asp-area="" asp-page="/Privacy">Privacy</a></li>
                    <partial name="_LoginPartial" />
                </ul>
            </details>
        </nav>
    </header>

    <main id="main-content" class="mx-auto max-w-5xl px-4 py-8">
        @RenderBody()
    </main>

    <footer class="border-t border-stone-200 py-6">
        <div class="mx-auto max-w-5xl px-4 text-sm text-stone-500">
            &copy; 2026 Library Lending &middot; <a class="link-muted" asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
