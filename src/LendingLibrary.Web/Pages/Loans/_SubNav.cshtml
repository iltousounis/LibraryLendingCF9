@{
    var current = (string)ViewData["ActiveLoansTab"]!;
}

<nav class="mt-4 flex gap-4 border-b border-stone-200">
    <a asp-page="./Current" class="@(current == "Current" ? "tab-link-active" : "tab-link")">Current</a>
    <a asp-page="./History" class="@(current == "History" ? "tab-link-active" : "tab-link")">History</a>
    <a asp-page="./Overdue" class="@(current == "Overdue" ? "tab-link-active" : "tab-link")">Overdue</a>
</nav>
