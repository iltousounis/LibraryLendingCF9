@{
    var current = (string)ViewData["ActiveLoansTab"]!;
}

<nav class="mt-4 flex gap-4 border-b border-gray-200 text-sm">
    <a asp-page="./Current" class="border-b-2 px-1 pb-2 @(current == "Current" ? "border-gray-900 font-medium text-gray-900" : "border-transparent text-gray-500 hover:text-gray-900")">Current</a>
    <a asp-page="./History" class="border-b-2 px-1 pb-2 @(current == "History" ? "border-gray-900 font-medium text-gray-900" : "border-transparent text-gray-500 hover:text-gray-900")">History</a>
    <a asp-page="./Overdue" class="border-b-2 px-1 pb-2 @(current == "Overdue" ? "border-gray-900 font-medium text-gray-900" : "border-transparent text-gray-500 hover:text-gray-900")">Overdue</a>
</nav>
