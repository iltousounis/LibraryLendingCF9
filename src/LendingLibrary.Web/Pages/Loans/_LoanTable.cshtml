@model IReadOnlyList<LendingLibrary.Web.Domain.Entities.Loan>
@inject TimeProvider TimeProvider
@{
    var now = TimeProvider.GetUtcNow();
    var showReturned = Model.Count > 0 && Model[0].Status == LendingLibrary.Web.Domain.Enums.LoanStatus.Returned;
}

@if (Model.Count == 0)
{
    <p class="mt-6 text-stone-600">Nothing here.</p>
}
else
{
    <div class="mt-6 table-card">
        <table class="table-base">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Borrowed</th>
                    @if (showReturned)
                    {
                        <th>Returned</th>
                    }
                    else
                    {
                        <th>Due</th>
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var loan in Model)
                {
                    <tr>
                        <td class="font-medium text-stone-900">@loan.CatalogueItem.Title</td>
                        <td>@loan.BorrowedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                        @if (showReturned)
                        {
                            <td>@loan.ReturnedAtUtc?.ToLocalTime().ToString("d MMM yyyy")</td>
                        }
                        else
                        {
                            <td>@loan.DueAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td class="text-right">
                                @if (loan.IsOverdue(now))
                                {
                                    <span class="badge-danger">Overdue</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
