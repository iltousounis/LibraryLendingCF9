@page
@model LendingLibrary.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="mx-auto max-w-sm">
    <h1 class="text-2xl font-bold">Log in</h1>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mt-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <div>
            <label asp-for="Input.Email" class="block text-sm font-medium">Email</label>
            <input asp-for="Input.Email" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-sm text-red-600"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="block text-sm font-medium">Password</label>
            <input asp-for="Input.Password" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-sm text-red-600"></span>
        </div>

        <div class="flex items-center gap-2">
            <input asp-for="Input.RememberMe" class="h-4 w-4 rounded border-gray-300" />
            <label asp-for="Input.RememberMe" class="text-sm">Remember me</label>
        </div>

        <button type="submit" class="w-full rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
            Log in
        </button>
    </form>

    <p class="mt-4 text-sm text-gray-600">
        Don't have an account?
        <a class="font-medium text-gray-900 hover:underline" asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
    </p>
</div>
