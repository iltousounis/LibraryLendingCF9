@page
@model LendingLibrary.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="mx-auto max-w-sm rounded-lg border border-stone-200 bg-white p-6 shadow-sm">
    <h1 class="page-title text-2xl">Create an account</h1>

    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="mt-6 space-y-4">
        <div asp-validation-summary="ModelOnly" class="field-error"></div>

        <div>
            <label asp-for="Input.DisplayName" class="field-label">Display name</label>
            <input asp-for="Input.DisplayName" class="field-input" autocomplete="name" />
            <span asp-validation-for="Input.DisplayName" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Input.Email" class="field-label">Email</label>
            <input asp-for="Input.Email" class="field-input" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Input.Password" class="field-label">Password</label>
            <input asp-for="Input.Password" class="field-input" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="field-error"></span>
        </div>

        <div>
            <label asp-for="Input.ConfirmPassword" class="field-label">Confirm password</label>
            <input asp-for="Input.ConfirmPassword" class="field-input" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
        </div>

        <button type="submit" class="btn-primary w-full">
            Create account
        </button>
    </form>

    <p class="mt-4 text-sm text-stone-600">
        Already have an account?
        <a class="link" asp-page="/Account/Login" asp-route-returnUrl="@Model.ReturnUrl">Log in</a>
    </p>
</div>
