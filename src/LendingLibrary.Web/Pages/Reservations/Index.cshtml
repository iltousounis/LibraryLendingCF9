@page
@model LendingLibrary.Web.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "My Reservations";
}

<h1 class="page-title">My reservations</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <p class="mt-4 alert-success">@Model.StatusMessage</p>
}

@if (Model.Results.Items.Count == 0)
{
    <p class="mt-6 text-stone-600">No pending reservations.</p>
}
else
{
    <div class="mt-6 table-card">
        <table class="table-base">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Reserved</th>
                    <th>Expires</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var reservation in Model.Results.Items)
                {
                    <tr>
                        <td class="font-medium text-stone-900">@reservation.CatalogueItem.Title</td>
                        <td>@reservation.ReservedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td>@reservation.ExpiresAtUtc.ToLocalTime().ToString("d MMM yyyy")</td>
                        <td class="text-right">
                            <form method="post" asp-page-handler="Cancel" asp-route-reservationId="@reservation.Id" asp-route-page="@Model.PageNumber">
                                <button type="submit" class="link-danger">Cancel</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<partial name="_Pager" model="Model.Pager" />
