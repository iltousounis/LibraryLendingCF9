@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="mx-auto max-w-sm text-center">
    <p class="text-sm font-medium text-stone-500">Error @Model.DisplayStatusCode</p>
    <h1 class="page-title mt-1 text-2xl">@Model.Heading</h1>
    <p class="mt-2 text-stone-600">@Model.Message</p>

    <a asp-area="" asp-page="/Index" class="link mt-6 inline-block">
        Back to home
    </a>

    @if (Model.ShowRequestId)
    {
        <p class="mt-8 text-xs text-stone-400">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
</div>
