@page "{statusCode:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Heading;
}

<div class="mx-auto max-w-sm text-center">
    <p class="text-sm font-medium text-gray-500">Error @Model.DisplayStatusCode</p>
    <h1 class="mt-1 text-2xl font-bold">@Model.Heading</h1>
    <p class="mt-2 text-gray-600">@Model.Message</p>

    <a asp-area="" asp-page="/Index" class="mt-6 inline-block font-medium text-gray-900 hover:underline">
        Back to home
    </a>

    @if (Model.ShowRequestId)
    {
        <p class="mt-8 text-xs text-gray-400">
            Request ID: <code>@Model.RequestId</code>
        </p>
    }
</div>
