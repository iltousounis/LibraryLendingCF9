@page
@model LendingLibrary.Web.Pages.Catalogue.IndexModel
@using LendingLibrary.Web.Domain.Enums
@{
    ViewData["Title"] = "Catalogue";
}

<h1 class="page-title">Catalogue</h1>

<form method="get" class="mt-4 grid grid-cols-1 gap-3 rounded-lg border border-stone-200 bg-white p-4 sm:grid-cols-2 lg:grid-cols-6">
    <div class="sm:col-span-2 lg:col-span-2">
        <label asp-for="Q" class="field-label">Search</label>
        <input asp-for="Q" placeholder="Title, author, ISBN, publisher..." class="field-input" />
    </div>

    <div>
        <label asp-for="Type" class="field-label">Type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ItemType>()" class="field-input">
            <option value="">Any</option>
        </select>
    </div>

    <div>
        <label asp-for="YearFrom" class="field-label">Year from</label>
        <input asp-for="YearFrom" type="number" class="field-input" />
    </div>

    <div>
        <label asp-for="YearTo" class="field-label">Year to</label>
        <input asp-for="YearTo" type="number" class="field-input" />
    </div>

    <div>
        <label asp-for="Publisher" class="field-label">Publisher</label>
        <input asp-for="Publisher" class="field-input" />
    </div>

    <div class="flex items-end gap-2">
        <div class="flex items-center gap-2">
            <input asp-for="AvailableOnly" class="field-checkbox" />
            <label asp-for="AvailableOnly" class="text-sm text-stone-700">Available only</label>
        </div>
    </div>

    <div class="sm:col-span-2 lg:col-span-6">
        <button type="submit" class="btn-primary">
            Search
        </button>
        <a asp-page="./Index" class="link-muted ml-2 text-sm">Clear filters</a>
    </div>
</form>

@if (Model.Results.Items.Count == 0)
{
    <p class="mt-8 text-stone-600">No items match your search.</p>
}
else
{
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in Model.Results.Items)
        {
            <a asp-page="./Details" asp-route-id="@item.Id" class="card-link flex gap-3">
                @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                {
                    <img src="@item.CoverImageUrl" alt="Cover of @item.Title" class="h-20 w-14 flex-none rounded-md border border-stone-200 object-cover shadow-sm" />
                }
                else
                {
                    <div class="flex h-20 w-14 flex-none items-center justify-center rounded-md border border-stone-200 bg-stone-100 text-[10px] text-stone-400">
                        No cover
                    </div>
                }
                <div class="min-w-0">
                    <p class="text-xs font-medium uppercase tracking-wide text-amber-800">@item.ItemType</p>
                    <h2 class="mt-1 font-serif font-semibold text-stone-900">@item.Title</h2>
                    @if (!string.IsNullOrEmpty(item.Authors))
                    {
                        <p class="text-sm text-stone-600">@item.Authors</p>
                    }
                    <p class="mt-2 text-sm @(item.AvailableUnits > 0 ? "text-emerald-700" : "text-rose-600")">
                        @(item.AvailableUnits > 0 ? $"{item.AvailableUnits} available" : "Out of stock")
                    </p>
                </div>
            </a>
        }
    </div>

    <partial name="_Pager" model="Model.Pager" />
}
