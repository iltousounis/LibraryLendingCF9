@page
@model LendingLibrary.Web.Pages.Catalogue.IndexModel
@using LendingLibrary.Web.Domain.Enums
@{
    ViewData["Title"] = "Catalogue";
}

<h1 class="text-2xl font-bold">Catalogue</h1>

<form method="get" class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-6">
    <div class="sm:col-span-2 lg:col-span-2">
        <label asp-for="Q" class="block text-sm font-medium">Search</label>
        <input asp-for="Q" placeholder="Title, author, ISBN, publisher..." class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>

    <div>
        <label asp-for="Type" class="block text-sm font-medium">Type</label>
        <select asp-for="Type" asp-items="Html.GetEnumSelectList<ItemType>()" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm">
            <option value="">Any</option>
        </select>
    </div>

    <div>
        <label asp-for="YearFrom" class="block text-sm font-medium">Year from</label>
        <input asp-for="YearFrom" type="number" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>

    <div>
        <label asp-for="YearTo" class="block text-sm font-medium">Year to</label>
        <input asp-for="YearTo" type="number" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>

    <div>
        <label asp-for="Publisher" class="block text-sm font-medium">Publisher</label>
        <input asp-for="Publisher" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm" />
    </div>

    <div class="flex items-end gap-2">
        <div class="flex items-center gap-2">
            <input asp-for="AvailableOnly" class="h-4 w-4 rounded border-gray-300" />
            <label asp-for="AvailableOnly" class="text-sm">Available only</label>
        </div>
    </div>

    <div class="sm:col-span-2 lg:col-span-6">
        <button type="submit" class="rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-800">
            Search
        </button>
        <a asp-page="./Index" class="ml-2 text-sm text-gray-600 hover:text-gray-900">Clear filters</a>
    </div>
</form>

@if (Model.Results.Items.Count == 0)
{
    <p class="mt-8 text-gray-600">No items match your search.</p>
}
else
{
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in Model.Results.Items)
        {
            <a asp-page="./Details" asp-route-id="@item.Id" class="block rounded-lg border border-gray-200 bg-white p-4 hover:shadow-sm">
                <p class="text-xs font-medium uppercase tracking-wide text-gray-500">@item.ItemType</p>
                <h2 class="mt-1 font-semibold">@item.Title</h2>
                @if (!string.IsNullOrEmpty(item.Authors))
                {
                    <p class="text-sm text-gray-600">@item.Authors</p>
                }
                <p class="mt-2 text-sm @(item.AvailableUnits > 0 ? "text-green-700" : "text-red-600")">
                    @(item.AvailableUnits > 0 ? $"{item.AvailableUnits} available" : "Out of stock")
                </p>
            </a>
        }
    </div>

    <partial name="_Pager" model="Model.Pager" />
}
