@page "{id:guid}"
@model LendingLibrary.Web.Pages.Catalogue.DetailsModel
@{
    ViewData["Title"] = Model.Item.Title;
}

<a asp-page="./Index" class="link-muted text-sm">&larr; Back to catalogue</a>

<div class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-3">
    <div class="md:col-span-1">
        @if (!string.IsNullOrEmpty(Model.Item.CoverImageUrl))
        {
            <img src="@Model.Item.CoverImageUrl" alt="Cover of @Model.Item.Title" class="aspect-[2/3] w-full rounded-lg border border-stone-200 object-cover shadow-sm" />
        }
        else
        {
            <div class="flex aspect-[2/3] w-full items-center justify-center rounded-lg border border-stone-200 bg-stone-100 text-sm text-stone-400">
                No cover
            </div>
        }
    </div>

    <div class="md:col-span-2">
        <p class="text-xs font-medium uppercase tracking-wide text-amber-800">@Model.Item.ItemType</p>
        <h1 class="page-title mt-1">@Model.Item.Title</h1>

        @if (!string.IsNullOrEmpty(Model.Item.Authors))
        {
            <p class="mt-1 text-stone-600">@Model.Item.Authors</p>
        }

        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3">
            @if (!string.IsNullOrEmpty(Model.Item.Publisher))
            {
                <div>
                    <dt class="text-stone-500">Publisher</dt>
                    <dd class="text-stone-800">@Model.Item.Publisher</dd>
                </div>
            }
            @if (Model.Item.PublicationYear is { } year)
            {
                <div>
                    <dt class="text-stone-500">Year</dt>
                    <dd class="text-stone-800">@year</dd>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.Item.Isbn))
            {
                <div>
                    <dt class="text-stone-500">ISBN</dt>
                    <dd class="text-stone-800">@Model.Item.Isbn</dd>
                </div>
            }
        </dl>

        @if (!string.IsNullOrEmpty(Model.Item.Description))
        {
            <p class="mt-4 text-stone-700">@Model.Item.Description</p>
        }

        <p class="mt-6 inline-block rounded-md px-3 py-1.5 text-sm font-medium @(Model.Item.AvailableUnits > 0 ? "bg-emerald-50 text-emerald-700" : "bg-rose-50 text-rose-600")">
            @(Model.Item.AvailableUnits > 0 ? $"{Model.Item.AvailableUnits} of {Model.Item.TotalUnits} available" : "Out of stock")
        </p>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <p class="mt-4 @(Model.StatusIsError ? "alert-error" : "alert-success")">
                @Model.StatusMessage
            </p>
        }

        <div class="mt-4 flex gap-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (Model.Item.AvailableUnits > 0)
                {
                    <form method="post" asp-page-handler="Borrow" asp-route-id="@Model.Item.Id">
                        <button type="submit" class="btn-primary">
                            Borrow
                        </button>
                    </form>
                    <form method="post" asp-page-handler="Reserve" asp-route-id="@Model.Item.Id">
                        <button type="submit" class="btn-secondary">
                            Reserve for pickup
                        </button>
                    </form>
                }
            }
            else
            {
                <a asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("./Details", new { id = Model.Item.Id })"
                   class="link text-sm">
                    @(Model.Item.AvailableUnits > 0 ? "Log in to borrow or reserve" : "Log in for updates")
                </a>
            }
        </div>
    </div>
</div>
